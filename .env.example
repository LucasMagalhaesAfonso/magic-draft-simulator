# Firebase config — get these from Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Socket server URL — use your Render deployment URL in production
# Leave blank to use http://localhost:3001 in dev
VITE_SOCKET_SERVER_URL=https://your-server.onrender.com
