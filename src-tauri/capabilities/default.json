{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "updater:default",
    "process:default",
    "process:allow-restart",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$TEMP/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$TEMP/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$TEMP/**" }] }
  ]
}
