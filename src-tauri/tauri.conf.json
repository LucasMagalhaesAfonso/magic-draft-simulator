{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magic Draft",
  "version": "0.9.8",
  "identifier": "com.lucas.magic-draft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Magic Draft Simulator",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCOTk1NEVFMTM5M0REMzMKUldRejNaTVQ3bFNaZXlldFlQZ3NqdGZ3RUxzODVlWmJKMjZyZTFiMmNrWVIzNjlrY096Z0MvSDEK",
      "endpoints": [
        "https://github.com/LucasMagalhaesAfonso/magic-draft-simulator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}